# Cepat UI — Environment Variables
# Copy file ini ke .env dan isi sesuai kebutuhan

# API Base URL untuk auth adapter & useApi()
# Untuk Laravel Sanctum: http://localhost:8000
# Untuk REST API: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# App name (optional, override app.config.ts)
VITE_APP_NAME="Cepat UI"
